rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /projects/{projectId} {
      allow read: if true;
      // New entries only need the title, datasets, and server timestamp.
      // Legacy entries with name/roll/supervisor remain readable.
      allow create: if
        request.resource.data.keys().hasAll(['projectTitle','datasets','createdAt']) &&
        request.resource.data.keys().hasOnly(['projectTitle','datasets','createdAt']) &&
        request.resource.data.projectTitle is string &&
        request.resource.data.projectTitle.size() > 0 &&
        request.resource.data.projectTitle.size() <= 240 &&
        request.resource.data.datasets is string &&
        request.resource.data.datasets.size() > 0 &&
        request.resource.data.datasets.size() <= 1000 &&
        request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // An authenticated user may read only their own admin flag.
    // No client can create, edit, or delete admin grants.
    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
  }
}