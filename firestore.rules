rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    function isInstitutionalGoogleUser() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.firebase.sign_in_provider == 'google.com' &&
        request.auth.token.email is string &&
        request.auth.token.email.matches('.*@isrt\\.ac\\.bd$');
    }

    match /projects/{projectId} {
      allow read: if true;
      // Creation is performed by the Netlify function after verifying the Firebase ID token.
      allow create: if false;
      allow update: if (
        isInstitutionalGoogleUser() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.ownerEmail == resource.data.ownerEmail &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['projectTitle','datasets']) &&
        request.resource.data.projectTitle is string &&
        request.resource.data.projectTitle.size() > 0 &&
        request.resource.data.projectTitle.size() <= 240 &&
        request.resource.data.datasets is string &&
        request.resource.data.datasets.size() > 0 &&
        request.resource.data.datasets.size() <= 1000
      ) || (
        isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['projectTitle','datasets','projectNumber']) &&
        request.resource.data.projectTitle is string &&
        request.resource.data.projectTitle.size() > 0 &&
        request.resource.data.projectTitle.size() <= 240 &&
        request.resource.data.datasets is string &&
        request.resource.data.datasets.size() > 0 &&
        request.resource.data.datasets.size() <= 1000 &&
        (!('projectNumber' in request.resource.data) || (request.resource.data.projectNumber is int && request.resource.data.projectNumber > 0))
      );
      allow delete: if isAdmin();
    }

    match /projectEditKeys/{keyHash} {
      allow read, write: if false;
    }

    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /counters/{counterId} {
      allow read: if counterId == 'projectSequence';
      allow create: if isAdmin() && counterId == 'projectSequence' &&
        request.resource.data.keys().hasOnly(['value']) &&
        request.resource.data.value is int && request.resource.data.value > 0;
      allow update: if counterId == 'projectSequence' &&
        request.resource.data.keys().hasOnly(['value']) &&
        request.resource.data.value is int && isAdmin();
      allow delete: if false;
    }
  }
}