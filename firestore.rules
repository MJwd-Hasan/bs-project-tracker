rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{projectId} {
      // Public read and create; existing entries cannot be edited or deleted.
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasAll(['name','classRoll','supervisor','projectTitle','datasets','createdAt']) &&
        request.resource.data.keys().hasOnly(['name','classRoll','supervisor','projectTitle','datasets','createdAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
        request.resource.data.classRoll is string && request.resource.data.classRoll.size() > 0 && request.resource.data.classRoll.size() <= 30 &&
        request.resource.data.supervisor is string && request.resource.data.supervisor.size() <= 120 &&
        request.resource.data.projectTitle is string && request.resource.data.projectTitle.size() > 0 && request.resource.data.projectTitle.size() <= 240 &&
        request.resource.data.datasets is string && request.resource.data.datasets.size() > 0 && request.resource.data.datasets.size() <= 1000 &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}