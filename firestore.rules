rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if false;
      // Open editing: any visitor may change public project fields.
      allow update: if (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','projectTitle','subtitle','datasets']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.projectTitle is string &&
        request.resource.data.projectTitle.size() > 0 &&
        request.resource.data.projectTitle.size() <= 240 &&
        (!('subtitle' in request.resource.data) || (request.resource.data.subtitle is string && request.resource.data.subtitle.size() <= 160)) &&
        request.resource.data.datasets is string &&
        request.resource.data.datasets.size() > 0 &&
        request.resource.data.datasets.size() <= 1000
      ) || (
        isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['projectNumber']) &&
        request.resource.data.projectNumber is int &&
        request.resource.data.projectNumber > 0
      );
      allow delete: if isAdmin();
    }

    match /projectEditKeys/{keyHash} {
      allow read, write: if false;
    }

    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /counters/{counterId} {
      allow read: if counterId == 'projectSequence';
      allow create: if isAdmin() && counterId == 'projectSequence' &&
        request.resource.data.keys().hasOnly(['value']) &&
        request.resource.data.value is int && request.resource.data.value > 0;
      allow update: if counterId == 'projectSequence' &&
        request.resource.data.keys().hasOnly(['value']) &&
        request.resource.data.value is int &&
        isAdmin();
      allow delete: if false;
    }
  }
}